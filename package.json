{
  "name": "toplinksho",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "admin:hash-password": "node scripts/generate-admin-password.mjs",
    "projects:seed-demo": "node --conditions=react-server --import ./scripts/register-aliases.mjs scripts/seed-demo-projects.mjs",
    "assets:generate": "npm run theme:generate && node --import ./scripts/register-aliases.mjs scripts/generate-pwa.mjs",
    "prebuild": "npm run assets:generate",
    "theme:generate": "node scripts/generate-theme.mjs",
    "predev": "npm run theme:generate"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@base-ui/react": "^1.9.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.39.0",
    "mongoose": "^9.12.1",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
