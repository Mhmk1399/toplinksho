# Copy to .env.local. Do not commit .env.local or share its values in chat.
APP_URL=http://localhost:3000

# Generate the hash with: npm run admin:hash-password
ADMIN_EMAIL=Info@TopLinkSho.com
ADMIN_PASSWORD_HASH=

# Server-only MongoDB connection. Never use NEXT_PUBLIC_MONGODB_URI.
MONGODB_URI=
MONGODB_DB_NAME=toplinksho

# Set true only for the live HTTPS domain, then rebuild.
# Preview and local builds remain noindex; robots/sitemap follow the same setting.
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# SMTP uses TLS on 465 or mandatory STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer TLS from port 465; set true for a custom TLS port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL=Info@TopLinkSho.com
